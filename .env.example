PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/klestarmart?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174
# Public address of this API; uploaded image URLs are built from it.
API_PUBLIC_URL=http://localhost:5050
# Signs login sessions. At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
SESSION_DAYS=7
# lax (same site, e.g. api.shop.com + admin.shop.com) or none (different domains; HTTPS only)
COOKIE_SAMESITE=lax
# Used once by `npm run seed` to create the first admin account.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
